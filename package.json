{
  "name": "power-paint",
  "private": true,
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "auth": "yarn workspace @power-paint/auth",
    "boards": "yarn workspace @power-paint/boards",
    "collab": "yarn workspace @power-paint/collab",
    "e2e": "yarn workspace @power-paint/e2e",
    "gateway": "yarn workspace @power-paint/gateway",
    "migrator": "yarn workspace @power-paint/migrator",
    "packages:build": "yarn workspace @power-paint/db generate && yarn workspace @power-paint/db build && yarn workspace @power-paint/contracts build && yarn workspace @power-paint/events build",
    "users": "yarn workspace @power-paint/users",
    "web": "yarn workspace @power-paint/web"
  },
  "resolutions": {
    "@auth/core": "0.41.1"
  }
}
