map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Единственный upstream - шлюз. Раньше nginx сам разводил трафик между
# фронтендом и WebSocket-сервером; теперь маршрутизация - забота шлюза,
# а nginx остаётся краем: TLS, статика, проксирование.
upstream gateway {
    server ${GATEWAY_HOST}:${GATEWAY_PORT};
}

# Зона кэша только для статики Next. Страницы и API зависят от куки
# пользователя, и общий кэш отдал бы одному чужой ответ.
proxy_cache_path /var/cache/nginx/next_static levels=1:2 keys_zone=next_static:10m
                 max_size=200m inactive=7d use_temp_path=off;

server {
    # default_server обязателен: в образе nginx лежит свой default.conf, и без
    # этого запросы по адресу, отличному от ${DOMAIN}, уходили бы в него.
    listen 80 default_server;
    server_name ${DOMAIN} _;

    client_max_body_size 10M;

    # Статика Next кэшируется агрессивно: имена файлов содержат хеш содержимого.
    location /_next/static {
        proxy_pass http://gateway;
        proxy_cache next_static;
        proxy_cache_valid 200 7d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Cache-Status $upstream_cache_status;
    }

    location / {
        proxy_pass http://gateway;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Буферизация выключена ради стриминга Next: с ней страница с Suspense
        # приходила бы целиком, а не сначала с заглушкой.
        proxy_buffering off;
        proxy_cache off;

        # Длинные таймауты нужны только соединениям совместного редактирования,
        # но отделить их здесь нечем - маршрут знает шлюз, а не nginx.
        proxy_connect_timeout 7d;
        proxy_send_timeout 7d;
        proxy_read_timeout 7d;
    }
}
