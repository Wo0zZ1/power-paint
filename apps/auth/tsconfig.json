{
	"compilerOptions": {
		"target": "ES2022",
		"module": "commonjs",
		"moduleResolution": "bundler",
		"strict": true,
		"strictPropertyInitialization": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"outDir": "./dist",
		"rootDir": "./src",
		"types": [
			"node"
		],
		"jsx": "react-jsx",
		"resolveJsonModule": true
	},
	"include": [
		"src/**/*"
	]
}
