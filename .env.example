# This is an example .env file. You can copy this to .env and fill in the values as needed.

# Database connection string
DATABASE_URL=postgres://user:password@localhost:5432/power-paint-server

# Use SSL for database connection (true/false)
DATABASE_SSL=false

# Port for the server to listen on
PORT=1234

# Secret for signing WebSocket tokens
WS_TOKEN_SECRET=YOUR_WS_TOKEN_SECRET_PLACEHOLDER

# Document table name (letters, numbers, _ only, default: yjs_documents)
HOCUSPOCUS_DOCUMENTS_TABLE="yjs_documents"

# SSL mode for Postgres (optional, usually empty or require)
PGSSLMODE=

# Allow untrusted SSL certificates (true/false, optional)
DATABASE_SSL_REJECT_UNAUTHORIZED=true