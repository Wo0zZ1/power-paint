# Единственный файл переменных: docker compose раздаёт их сервисам сам.
# Каждый сервис проверяет своё окружение zod-схемой на старте и падает сразу,
# если чего-то не хватает. Значения ниже - заглушки, реальные в .env.

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=power-paint-db

# Хост db - имя сервиса в сети compose. Схему в строке не указываем:
# у каждого сервиса своя схема, Prisma выбирает её по модели.
DATABASE_URL=postgresql://postgres:your_password@db:5432/power-paint-db?sslmode=disable

# ==========================================
# Redis - Pub/Sub между сервисами, кэш сессий и счётчики rate limit
# ==========================================
REDIS_URL=redis://redis:6379

# ==========================================
# Адреса сервисов внутри сети compose
# ==========================================
GATEWAY_URL=http://gateway:3001
AUTH_SERVICE_URL=http://auth:3002
USERS_SERVICE_URL=http://users:3003
BOARDS_SERVICE_URL=http://boards:3004
COLLAB_SERVICE_URL=http://collab:3005
WEB_SERVICE_URL=http://web:3000

# ==========================================
# Gateway
# ==========================================
# Чей X-Forwarded-For принимать. По умолчанию список пуст - тогда ключом
# rate limit становится адрес nginx, и все клиенты делят один счётчик.
TRUSTED_PROXIES=172.16.0.0/12

# ==========================================
# Auth
# ==========================================
# Внешний адрес: на него возвращается OAuth-провайдер и по нему строятся
# ссылки в письмах.
PUBLIC_BASE_URL=http://localhost

AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret

EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_LOGIN=your_email@example.com
EMAIL_PASSWORD=your_email_password

# Secure-флаг куки сессии. Под HTTPS - true, иначе браузер её не примет.
COOKIE_SECURE=false

# ==========================================
# Web - вшивается в бандл на этапе сборки, не читается в рантайме
# ==========================================
NEXT_PUBLIC_BASE_URL=http://localhost
NEXT_PUBLIC_BASE_DEPLOY_URL=https://your-deploy-url.com
NEXT_PUBLIC_WS_URL=ws://localhost/collab

# Секрет загрузки картинок (аватары, изображения на холсте) - читается в
# рантайме, поэтому в образ не вшивается. Выдаётся в кабинете uploadthing.com.
UPLOADTHING_TOKEN=your-uploadthing-token

# ==========================================
# Migrator
# ==========================================
RUN_SEED=false

# ==========================================
# Nginx
# ==========================================
DOMAIN=power-paint.duckdns.org
