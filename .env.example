# --------------------------------
# PostgreSQL connection parameters

# PostgreSQL user (default: postgres)
POSTGRES_USER=postgres

# PostgreSQL password(default: qwerty123)
POSTGRES_PASSWORD=qwerty123

# PostgreSQL host (default: localhost)
POSTGRES_HOST=localhost

# PostgreSQL port (default: 5432)
POSTGRES_PORT=5432

# PostgreSQL database name (default: power-paint-db)
POSTGRES_DB=power-paint-db

# Schema for Postgres (default: public)
POSTGRES_SCHEMA=public

# SSL mode for Postgres (default: disable)
POSTGRES_SSLMODE=disable

# Allow untrusted SSL certificates (true/false, optional)
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# --------------------------------

# Port for the server to listen on
PORT=3001

# Secret for signing WebSocket tokens
WS_TOKEN_SECRET=qwerty123

# Document table name (letters, numbers, _ only, default: yjs_documents)
HOCUSPOCUS_DOCUMENTS_TABLE=yjs_documents