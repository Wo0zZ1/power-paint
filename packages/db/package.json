{
	"name": "@power-paint/db",
	"version": "1.0.0",
	"private": true,
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		}
	},
	"scripts": {
		"generate": "prisma generate",
		"build": "tsc && node -e \"require('fs').cpSync('src/generated','dist/generated',{recursive:true})\"",
		"migrate:dev": "prisma migrate dev",
		"migrate:deploy": "prisma migrate deploy",
		"studio": "prisma studio"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.4.0",
		"@prisma/client": "^7.4.0",
		"pg": "^8.16.3"
	},
	"devDependencies": {
		"@types/pg": "^8.15.6",
		"dotenv": "^17.4.1",
		"prisma": "^7.4.2",
		"typescript": "^6.0.2"
	}
}
